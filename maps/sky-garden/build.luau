			position = { x, y, z },
			size = { sx, sy, sz },
			color = look.color,
			material = look.material,
		})
		if bounce then
			part:SetAttribute("BouncePower", bounce)
		end
		if phase then
			part:SetAttribute("SwingLength", SEAT_LENGTH)
			part:SetAttribute("SwingAngle", SEAT_ANGLE)
			part:SetAttribute("SwingPeriod", SEAT_PERIOD)
			part:SetAttribute("SwingPhase", phase)
			table.insert(seats, i)
		end
	end

	-- Checkpoints
	for n, i in CHECKPOINT_AT do
		local _, x, y, z, _, sy = table.unpack(COURSE[i], 1, 9)
