-- Layout source: LAYOUT.md. Map Builder owns the structure; Polish owns THEME and Decoration.

local THEME = {
	spawn = "#3a86ff",
	platform = "#ffbe0b",
	platformMaterial = "SmoothPlastic",
	checkpoint = "#06d6a0",
	lava = "#ff4d00",
}

local PLATFORMS = 12
local SPACING = 11 -- centre to centre along z -> 5-stud gaps between 6-stud platforms
local RISE = 1.5 -- each platform is this much higher than the last
local CHECKPOINT_EVERY = 4

return function(kit)
	local map = kit.map()

	kit.spawn(map, { position = { 0, 0.5, 0 }, size = { 12, 1, 12 }, color = THEME.spawn })

	for i = 1, PLATFORMS do
		local x = if i % 2 == 0 then 4 else -4
		local y = 0.5 + i * RISE
		local z = 6 + i * SPACING - 5
		kit.platform(map, i, {
			position = { x, y, z },
			size = { 6, 1, 6 },
			color = THEME.platform,
			material = THEME.platformMaterial,
		})
		if i % CHECKPOINT_EVERY == 0 then
			kit.checkpoint(map, i // CHECKPOINT_EVERY, {
				position = { x, y + 0.6, z },
				size = { 4, 0.2, 4 },
				color = THEME.checkpoint,
				material = "Neon",
			})
		end
	end

	kit.hazard(map, "Lava", {
		position = { 0, -12, 70 },
		size = { 120, 1, 180 },
		color = THEME.lava,
		material = "Neon",
	})

	return map
end
